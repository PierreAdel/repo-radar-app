# Optional GitHub personal access token, used server-side only by the /api functions
# to raise the GitHub REST API rate limit from 60/hr to 5000/hr. Never prefix with
# VITE_ — that would bundle it into client-side JS.
GITHUB_TOKEN=

# Sentry DSN for the /api functions (error tracking + performance). Server-only.
SENTRY_DSN=

# Sentry DSN for the browser app (errors, performance/Web Vitals, session replay).
# VITE_-prefixed so Vite bundles it into client-side JS - a DSN is safe to expose,
# it's a write-only ingest endpoint, not a secret.
VITE_SENTRY_DSN=
