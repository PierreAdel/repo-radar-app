# Optional GitHub personal access token, used server-side only by the /api functions
# to raise the GitHub REST API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# Sentry DSN for the /api functions (error tracking + performance). Server-only.
SENTRY_DSN=

# Sentry DSN for the browser app (errors, performance/Web Vitals, session replay).
VITE_SENTRY_DSN=
