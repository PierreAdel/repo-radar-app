{
  "name": "repo-radar-app",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test && vitest run",
    "test:api": "vitest run",
    "test:coverage": "turbo run test:coverage && vitest run --coverage",
    "test:snapshots": "turbo run test:snapshots && vitest run -t snapshot",
    "check:fast": "pnpm typecheck && eslint .",
    "check:task": "pnpm check:fast && pnpm test:coverage",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "wait-for-preview": "node scripts/wait-for-vercel-preview.mjs",
    "stress-test": "k6 run load-tests/github-search.js && k6 run load-tests/github-repo.js",
    "storybook": "turbo run storybook --filter=@repo-radar/ui",
    "build-storybook": "turbo run build-storybook --filter=@repo-radar/ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.9.0",
    "@vercel/node": "^13.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@repo-radar/core": "workspace:^",
    "@sentry/node": "^10.75.0"
  }
}
